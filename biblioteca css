:root {
    --bg-color: #f4f5f9;
    --card-bg: #ffffff;
    --primary: #5c6bc0;
    --primary-hover: #3c4a9d;
    --text-main: #333333;
    --text-muted: #7e8299;
    --border-color: #ebedf2;
    --shadow: 0 10px 30px 0 rgba(82, 63, 105, 0.08);
    --radius-lg: 20px;
    --radius-md: 12px;
}

* {
    margin: 0;
    padding: 0;
    box-sizing: border-box;
    font-family: 'Segoe UI', Tahoma, Geneva, Verdana, sans-serif;
}

body {
    background-color: var(--bg-color);
    color: var(--text-main);
    min-height: 100vh;
    display: flex;
    flex-direction: column;
}

header {
    background-color: var(--card-bg);
    padding: 20px 40px;
    display: flex;
    justify-content: space-between;
    align-items: center;
    border-bottom: 1px solid var(--border-color);
    box-shadow: var(--shadow);
}

header h1 {
    color: var(--primary);
    font-size: 1.5rem;
}

header nav {
    display: flex;
    gap: 20px;
}

header nav a {
    text-decoration: none;
    color: var(--text-muted);
    font-weight: 500;
    transition: color 0.3s ease;
}

header nav a:hover {
    color: var(--primary);
}

main {
    flex: 1;
    width: 100%;
    max-width: 1200px;
    margin: 0 auto;
    padding: 40px 20px;
    display: flex;
    flex-direction: column;
    gap: 40px;
}

section {
    background-color: var(--card-bg);
    padding: 30px;
    border-radius: var(--radius-lg);
    box-shadow: var(--shadow);
}

section h2 {
    margin-bottom: 20px;
    color: var(--text-main);
    font-size: 1.3rem;
}

#campo-busca {
    width: 100%;
    padding: 12px 20px;
    border: 1px solid var(--border-color);
    border-radius: var(--radius-md);
    outline: none;
    font-size: 0.95rem;
    color: var(--text-main);
    background: var(--bg-color);
    margin-bottom: 1.5rem;
    transition: border-color 0.3s ease;
}

#campo-busca:focus {
    border-color: var(--primary);
}

.filtros-extras select {
    background-color: var(--bg-color);
    border: 1px solid var(--border-color);
    border-radius: var(--radius-md);
    color: var(--text-main);
    outline: none;
    transition: border-color 0.3s ease;
}

.filtros-extras select:focus {
    border-color: var(--primary);
}

.grade-livros {
    display: grid;
    grid-template-columns: repeat(auto-fit, minmax(250px, 1fr));
    gap: 20px;
    margin-top: 20px;
}

.livro {
    background-color: var(--bg-color);
    padding: 25px;
    border-radius: var(--radius-md);
    border: 1px solid var(--border-color);
    font-weight: 600;
    color: var(--text-main);
    box-shadow: var(--shadow);
    transition: transform 0.3s ease, border-color 0.3s ease;
}

.livro:hover {
    transform: translateY(-5px);
    border-color: var(--primary);
}

#form-sugestao {
    display: flex;
    flex-direction: column;
    gap: 20px;
}

#form-sugestao div {
    display: flex;
    flex-direction: column;
    gap: 8px;
}

#form-sugestao label {
    font-weight: 500;
    font-size: 0.9rem;
    color: var(--text-muted);
}

#form-sugestao input {
    padding: 12px 15px;
    border: 1px solid var(--border-color);
    border-radius: var(--radius-md);
    outline: none;
    font-size: 0.95rem;
    background: var(--bg-color);
    color: var(--text-main);
    transition: border-color 0.3s ease;
}

#form-sugestao input:focus {
    border-color: var(--primary);
}

#form-sugestao button {
    background-color: var(--primary);
    color: white;
    border: none;
    padding: 12px 20px;
    border-radius: var(--radius-md);
    font-weight: 600;
    cursor: pointer;
    transition: background-color 0.3s ease;
    align-self: flex-start;
}

#form-sugestao button:hover {
    background-color: var(--primary-hover);
}

#mensagem-feedback {
    margin-top: 15px;
    font-weight: 500;
    font-size: 0.95rem;
}

footer {
    background-color: var(--card-bg);
    padding: 20px 40px;
    display: flex;
    justify-content: space-between;
    align-items: center;
    border-top: 1px solid var(--border-color);
    color: var(--text-muted);
    font-size: 0.9rem;
}

footer a {
    text-decoration: none;
    color: var(--primary);
    font-weight: 500;
}

footer a:hover {
    text-decoration: underline;
}

@media (max-width: 768px) {
    header {
        flex-direction: column;
        gap: 15px;
        padding: 20px;
        text-align: center;
    }

    footer {
        flex-direction: column;
        gap: 10px;
        text-align: center;
    }

    main {
        padding: 20px 10px;
    }
}
